{
  "name": "@prospero/daemon",
  "version": "0.0.13",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "esaytree": "./bin/esaytree",
    "prosperod": "./dist/cli.js",
    "prospero": "./bin/prospero"
  },
  "scripts": {
    "prebuild": "npm run build:protocol",
    "build": "tsc --build",
    "build:protocol": "tsc --build --force ../../packages/protocol",
    "predev": "npm run build:protocol",
    "dev": "node --experimental-strip-types src/cli.ts",
    "pretest": "npm run build:protocol && tsc --build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.221",
    "@prospero/protocol": "*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "bonjour-service": "^1.4.0",
    "commander": "^13.0.0",
    "cross-spawn": "^7.0.6",
    "node-pty": "^1.1.0",
    "qrcode-terminal": "^0.12.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.13",
    "vitest": "^3.2.7"
  }
}
