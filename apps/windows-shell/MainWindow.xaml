<Window x:Class="Prospero.WindowsShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prospero" Width="1320" Height="820" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{DynamicResource SidebarBrush}" Margin="0">
            <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="22,22,16,18" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="10" ClipToBounds="True">
                    <Image Source="/ProsperoShell;component/Assets/icon.png" Stretch="UniformToFill"/>
                </Border>
                <TextBlock Text="Prospero" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
            <ListBox x:Name="Navigation" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="14,8" SelectionChanged="Navigation_SelectionChanged">
                <ListBoxItem Style="{StaticResource NavItem}" Tag="0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/><TextBlock Text="概览" Style="{StaticResource NavLabel}"/></StackPanel></ListBoxItem>
                <ListBoxItem Style="{StaticResource NavItem}" Tag="1"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource NavIcon}"/><TextBlock Text="项目与会话" Style="{StaticResource NavLabel}"/></StackPanel></ListBoxItem>
                <ListBoxItem Style="{StaticResource NavItem}" Tag="2"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" Style="{StaticResource NavIcon}"/><TextBlock Text="账号" Style="{StaticResource NavLabel}"/></StackPanel></ListBoxItem>
                <ListBoxItem Style="{StaticResource NavItem}" Tag="3"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" Style="{StaticResource NavIcon}"/><TextBlock Text="编排" Style="{StaticResource NavLabel}"/></StackPanel></ListBoxItem>
                <ListBoxItem Style="{StaticResource NavItem}" Tag="4"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE975;" Style="{StaticResource NavIcon}"/><TextBlock Text="设备" Style="{StaticResource NavLabel}"/></StackPanel></ListBoxItem>
                <ListBoxItem Style="{StaticResource NavItem}" Tag="5"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource NavIcon}"/><TextBlock Text="日志" Style="{StaticResource NavLabel}"/></StackPanel></ListBoxItem>
                <ListBoxItem Style="{StaticResource NavItem}" Tag="6"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/><TextBlock Text="设置" Style="{StaticResource NavLabel}"/></StackPanel></ListBoxItem>
            </ListBox>
            <Button Grid.Row="2" Content="退出 Prospero" Style="{StaticResource DangerButton}" Margin="20,14" Click="Exit_Click"/>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="30,16,30,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border x:Name="StatusPill" CornerRadius="18" Background="{DynamicResource OrangeSoftBrush}" Padding="14,7" HorizontalAlignment="Left" MaxWidth="440">
                    <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource OrangeBrush}" Margin="0,0,10,0"/><TextBlock x:Name="StatusText" Foreground="{DynamicResource OrangeBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="配对设备" Click="PairDevice_Click"/>
                    <Button Content="启动 daemon" Style="{StaticResource PrimaryButton}" Click="StartDaemon_Click"/>
                    <Button Content="重启" Click="RestartDaemon_Click" Margin="0,0,0,8"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="30,10,30,28">
                <Grid x:Name="OverviewPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="远程 Agent 控制中心" Style="{StaticResource PageTitle}"/>
                        <UniformGrid Columns="3" Margin="0,0,0,14">
                            <Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="Daemon" Style="{StaticResource MutedText}" FontWeight="SemiBold"/><TextBlock x:Name="OverviewDaemonValue" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock x:Name="OverviewDaemonDetail" Style="{StaticResource MutedText}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="7,0"><StackPanel><TextBlock Text="活跃会话" Style="{StaticResource MutedText}" FontWeight="SemiBold"/><TextBlock x:Name="OverviewSessionValue" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock x:Name="OverviewSessionDetail" Style="{StaticResource MutedText}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="7,0,0,0"><StackPanel><TextBlock Text="已配对设备" Style="{StaticResource MutedText}" FontWeight="SemiBold"/><TextBlock x:Name="OverviewDeviceValue" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock x:Name="OverviewDeviceDetail" Style="{StaticResource MutedText}"/></StackPanel></Border>
                        </UniformGrid>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="持久化状态" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock x:Name="PersistenceText" Style="{StaticResource MutedText}" TextWrapping="Wrap"/></StackPanel></Border>
                        <WrapPanel><Button Content="启动 daemon" Style="{StaticResource PrimaryButton}" Click="StartDaemon_Click"/><Button Content="停止 daemon" Style="{StaticResource DangerButton}" Click="StopDaemon_Click"/><Button Content="重启 daemon" Click="RestartDaemon_Click"/><Button Content="配对新设备" Click="PairDevice_Click"/><Button Content="打开数据目录" Click="OpenData_Click"/></WrapPanel>
                    </StackPanel></ScrollViewer>
                </Grid>

                <Grid x:Name="SessionsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="项目与会话" Style="{StaticResource PageTitle}"/>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,4"><Button Content="打开会话" Click="OpenSession_Click"/><Button Content="在项目中新建会话" Style="{StaticResource PrimaryButton}" Click="NewSession_Click"/><Button Content="添加项目" Click="AddProject_Click"/><Button Content="移除项目书签" Click="RemoveProject_Click"/><Button Content="中断" Click="InterruptSession_Click"/><Button Content="结束" Click="KillSession_Click"/><Button Content="刷新" Click="Refresh_Click"/></WrapPanel>
                    <TabControl Grid.Row="2">
                        <TabItem Header="项目"><DataGrid x:Name="ProjectsGrid" BorderThickness="0" MouseDoubleClick="ProjectsGrid_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="项目" Binding="{Binding Name}" Width="1*"/><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="3*"/><DataGridTextColumn Header="活跃会话" Binding="{Binding Active}" Width="1*"/></DataGrid.Columns></DataGrid></TabItem>
                        <TabItem Header="会话"><DataGrid x:Name="SessionsGrid" BorderThickness="0" MouseDoubleClick="SessionsGrid_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Agent" Binding="{Binding Agent}"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}"/><DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="项目目录" Binding="{Binding Cwd}" Width="3*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}"/><DataGridTextColumn Header="待处理" Binding="{Binding Pending}"/></DataGrid.Columns></DataGrid></TabItem>
                    </TabControl>
                </Grid>

                <Grid x:Name="AccountsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Code Agent 账号" Style="{StaticResource PageTitle}"/>
                    <WrapPanel Grid.Row="1"><Button Content="刷新账号" Click="RefreshAccounts_Click"/><Button Content="新增独立账号" Style="{StaticResource PrimaryButton}" Click="AddAccount_Click"/><Button Content="新增 API Profile" Click="AddApiProfile_Click"/><Button Content="配置 API" Click="ConfigureApi_Click"/><Button Content="重命名" Click="RenameAccount_Click"/><Button Content="设为默认" Click="DefaultAccount_Click"/><Button Content="导入凭据" Click="Credential_Click"/><Button Content="登录" Click="LoginAccount_Click"/><Button Content="注销" Click="LogoutAccount_Click"/><Button Content="删除" Click="DeleteAccount_Click"/></WrapPanel>
                    <Border Grid.Row="2" Style="{StaticResource DataTableFrame}" Margin="0,8,0,0"><DataGrid x:Name="AccountsGrid" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="Agent" Binding="{Binding Agent}"/><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="1.5*"/><DataGridTextColumn Header="环境" Binding="{Binding Environment}"/><DataGridTextColumn Header="默认" Binding="{Binding Default}"/><DataGridTextColumn Header="登录状态" Binding="{Binding Status}"/><DataGridTextColumn Header="活跃会话" Binding="{Binding Active}"/><DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="2*"/></DataGrid.Columns></DataGrid></Border>
                </Grid>

                <Grid x:Name="OrchestrationPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="编排" Style="{StaticResource PageTitle}"/>
                    <WrapPanel Grid.Row="1"><Button Content="新建 Run" Style="{StaticResource PrimaryButton}" Click="CreateRun_Click"/><Button Content="完成 Run" Click="CompleteRun_Click"/><Button Content="放弃 Run" Click="AbandonRun_Click"/><Button Content="删除 Run" Click="DeleteRun_Click"/><Button Content="新建 Task" Click="CreateTask_Click"/><Button Content="启动 Worker" Click="StartWorker_Click"/><Button Content="停止 Worker" Click="StopWorker_Click"/><Button Content="取消 Task" Click="CancelTask_Click"/><Button Content="重试 Task" Click="RetryTask_Click"/><Button Content="启动自动编排" Click="StartAutomation_Click"/><Button Content="暂停自动编排" Click="PauseAutomation_Click"/><Button Content="批准 Gate" Click="ApproveGate_Click"/><Button Content="拒绝 Gate" Click="RejectGate_Click"/></WrapPanel>
                    <TabControl Grid.Row="2">
                        <TabItem Header="Runs"><DataGrid x:Name="RunsGrid" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="目标" Binding="{Binding Objective}" Width="3*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}"/><DataGridTextColumn Header="更新时间" Binding="{Binding Updated}"/><DataGridTextColumn Header="Run ID" Binding="{Binding Id}" Width="2*"/></DataGrid.Columns></DataGrid></TabItem>
                        <TabItem Header="Tasks"><DataGrid x:Name="TasksGrid" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="任务" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}"/><DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="3*"/><DataGridTextColumn Header="Task ID" Binding="{Binding Id}" Width="2*"/></DataGrid.Columns></DataGrid></TabItem>
                        <TabItem Header="Gates"><DataGrid x:Name="GatesGrid" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="问题" Binding="{Binding Question}" Width="3*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}"/><DataGridTextColumn Header="决定" Binding="{Binding Decision}"/><DataGridTextColumn Header="Gate ID" Binding="{Binding Id}" Width="2*"/></DataGrid.Columns></DataGrid></TabItem>
                    </TabControl>
                </Grid>

                <Grid x:Name="DevicesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="设备" Style="{StaticResource PageTitle}"/>
                    <WrapPanel Grid.Row="1"><Button Content="配对新设备" Style="{StaticResource PrimaryButton}" Click="PairDevice_Click"/><Button Content="撤销设备" Click="RevokeDevice_Click"/><Button Content="刷新" Click="Refresh_Click"/></WrapPanel>
                    <Border Grid.Row="2" Style="{StaticResource DataTableFrame}" Margin="0,8,0,0"><DataGrid x:Name="DevicesGrid" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="设备名" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Shell" Binding="{Binding Shell}"/><DataGridTextColumn Header="编排" Binding="{Binding Orchestration}"/><DataGridTextColumn Header="绑定" Binding="{Binding Bound}"/><DataGridTextColumn Header="最后在线" Binding="{Binding LastSeen}" Width="2*"/></DataGrid.Columns></DataGrid></Border>
                </Grid>

                <Grid x:Name="LogsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="日志" Style="{StaticResource PageTitle}"/>
                    <WrapPanel Grid.Row="1"><Button Content="清空日志" Click="ClearLogs_Click"/><Button Content="打开日志目录" Click="OpenData_Click"/></WrapPanel>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Background="{DynamicResource TerminalBrush}" BorderBrush="{DynamicResource TerminalBrush}" Padding="16">
                        <TextBox x:Name="LogsText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TerminalTextBrush}" FontFamily="Cascadia Mono, Microsoft YaHei UI" FontSize="13"/>
                    </Border>
                </Grid>

                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
                        <Border Style="{StaticResource Card}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="54"/><RowDefinition Height="54"/><RowDefinition Height="54"/><RowDefinition Height="64"/><RowDefinition Height="46"/><RowDefinition Height="46"/><RowDefinition Height="54"/><RowDefinition Height="54"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Node.js" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1" Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="NodeModeCombo" Width="182" Height="38" VerticalAlignment="Center" HorizontalAlignment="Left" SelectionChanged="NodeModeCombo_SelectionChanged"><ComboBoxItem Content="系统 / NVM 当前版本" Tag="system"/><ComboBoxItem Content="指定 node.exe" Tag="explicit"/></ComboBox>
                                <TextBox x:Name="NodePathText" Grid.Column="1" Margin="8,0,0,0"/>
                            </Grid>
                            <Button x:Name="BrowseNodeButton" Grid.Column="2" Content="浏览…" Margin="8,6,0,6" Click="BrowseNode_Click"/>
                            <TextBlock Grid.Row="1" Text="prosperod CLI" VerticalAlignment="Center"/><TextBox x:Name="CliPathText" Grid.Row="1" Grid.Column="1" Margin="0,6"/><Button Grid.Row="1" Grid.Column="2" Content="浏览…" Margin="8,6,0,6" Click="BrowseCli_Click"/>
                            <TextBlock Grid.Row="2" Text="监听地址" VerticalAlignment="Center"/><TextBox x:Name="BindText" Grid.Row="2" Grid.Column="1" Margin="0,6"/>
                            <TextBlock Grid.Row="3" Text="Relay URL" VerticalAlignment="Center"/><TextBox x:Name="RelayUrlText" Grid.Row="3" Grid.Column="1" Margin="0,6"/>
                            <TextBlock x:Name="RelayStatusText" Grid.Row="4" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <WrapPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center"><Button Content="启用" Click="EnableRelay_Click"/><Button Content="关闭" Click="DisableRelay_Click"/><Button Content="刷新" Click="RefreshRelay_Click"/><Button Content="轮换密钥…" Click="RotateRelay_Click"/></WrapPanel>
                            <CheckBox x:Name="StartupToggle" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ToggleSwitch}" Content="登录 Windows 时自动启动 Prospero（后台托盘）"/>
                            <CheckBox x:Name="DaemonLaunchToggle" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ToggleSwitch}" Content="Prospero 启动时自动启动 daemon"/>
                            <TextBlock Grid.Row="7" Text="界面主题" VerticalAlignment="Center"/><ComboBox x:Name="ThemeCombo" Grid.Row="7" Grid.Column="1" Width="176" Height="36" VerticalAlignment="Center" HorizontalAlignment="Left" SelectionChanged="ThemeCombo_SelectionChanged"><ComboBoxItem Content="跟随 Windows" Tag="system"/><ComboBoxItem Content="浅色" Tag="light"/><ComboBoxItem Content="深色" Tag="dark"/></ComboBox>
                            <WrapPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"><Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click"/><Button Content="保存并重启" Click="SaveRestart_Click"/><Button Content="打开数据目录" Click="OpenData_Click"/><Button Content="运行自检" Click="SelfCheck_Click"/></WrapPanel>
                            <TextBlock x:Name="SettingsNote" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                        </Grid></Border>
                    </StackPanel></ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
