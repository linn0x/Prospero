# Prospero owns the window, session process, and application shortcuts.
background = #16171a
foreground = #e6e9f0
cursor-color = #e6e9f0
cursor-text = #16171a
selection-background = #2b3b5c
selection-foreground = #f2f5fa
bold-is-bright = false
palette = 0=#20232b
palette = 1=#f06b74
palette = 2=#62c897
palette = 3=#e8b259
palette = 4=#6ea4f8
palette = 5=#b98ef5
palette = 6=#59c4dc
palette = 7=#c9d0de
palette = 8=#7d8597
palette = 9=#ff878f
palette = 10=#7ee0b0
palette = 11=#f5c776
palette = 12=#8cb8ff
palette = 13=#ceaaff
palette = 14=#7ad9ee
palette = 15=#f2f5fa
font-family = Menlo
font-size = 13
mouse-scroll-multiplier = precision:1.5
window-padding-x = 10
window-padding-y = 8
shell-integration = none
clipboard-read = deny
clipboard-write = allow
confirm-close-surface = false
keybind = clear
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+a=select_all
keybind = shift+enter=csi:13;2u
keybind = shift+numpad_enter=csi:13;2u
