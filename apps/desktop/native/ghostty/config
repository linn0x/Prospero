# Prospero owns the window, session process, and application shortcuts.
background = #16171a
foreground = #e6e8ee
font-family = Menlo
font-size = 13
mouse-scroll-multiplier = precision:1.5
window-padding-x = 10
window-padding-y = 8
shell-integration = none
clipboard-read = deny
clipboard-write = allow
confirm-close-surface = false
keybind = clear
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+a=select_all
