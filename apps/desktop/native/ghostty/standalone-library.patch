+/// Accumulate pixel scroll offsets until they cover whole terminal cells.
+/// Truncating toward zero preserves the sub-cell remainder in either direction.
+fn accumulatePixelScroll(pending: *f64, offset: f64, cell_size: f64) isize {
+    assert(cell_size > 0);
+    // On a direction change, discard the old direction's sub-cell fraction so
+    // it cannot cancel the first movement in the new direction.
+    if (offset != 0 and pending.* != 0 and ((pending.* > 0) != (offset > 0))) {
+        pending.* = 0;
+    }
+
+    const total = pending.* + offset;
+    if (@abs(total) < cell_size) {
+        pending.* = total;
+        return 0;
+    }
+
+    const amount = total / cell_size;
+    const delta: isize = @intFromFloat(@trunc(amount));
+    assert(@abs(delta) >= 1);
+    pending.* = total - (@as(f64, @floatFromInt(delta)) * cell_size);
+    return delta;
+}
+
+test "Surface: precise scroll accumulation preserves cell remainder" {
+    var pending_y: f64 = 0;
+    try std.testing.expectEqual(@as(isize, 0), accumulatePixelScroll(&pending_y, 20, 30));
+    try std.testing.expectEqual(@as(f64, 20), pending_y);
+    try std.testing.expectEqual(@as(isize, 1), accumulatePixelScroll(&pending_y, 20, 30));
+    try std.testing.expectEqual(@as(f64, 10), pending_y);
+    try std.testing.expectEqual(@as(isize, 1), accumulatePixelScroll(&pending_y, 20, 30));
+    try std.testing.expectEqual(@as(f64, 0), pending_y);
+
+    var pending_y_negative: f64 = 0;
+    try std.testing.expectEqual(@as(isize, 0), accumulatePixelScroll(&pending_y_negative, -20, 30));
+    try std.testing.expectEqual(@as(f64, -20), pending_y_negative);
+    try std.testing.expectEqual(@as(isize, -1), accumulatePixelScroll(&pending_y_negative, -20, 30));
+    try std.testing.expectEqual(@as(f64, -10), pending_y_negative);
+    try std.testing.expectEqual(@as(isize, -1), accumulatePixelScroll(&pending_y_negative, -20, 30));
+    try std.testing.expectEqual(@as(f64, 0), pending_y_negative);
+
+    var pending_x_positive: f64 = 0;
+    try std.testing.expectEqual(@as(isize, 0), accumulatePixelScroll(&pending_x_positive, 20, 30));
+    try std.testing.expectEqual(@as(f64, 20), pending_x_positive);
+    try std.testing.expectEqual(@as(isize, 1), accumulatePixelScroll(&pending_x_positive, 20, 30));
+    try std.testing.expectEqual(@as(f64, 10), pending_x_positive);
+    try std.testing.expectEqual(@as(isize, 1), accumulatePixelScroll(&pending_x_positive, 20, 30));
+    try std.testing.expectEqual(@as(f64, 0), pending_x_positive);
+
+    var pending_x: f64 = 0;
+    try std.testing.expectEqual(@as(isize, 0), accumulatePixelScroll(&pending_x, -20, 30));
+    try std.testing.expectEqual(@as(f64, -20), pending_x);
+    try std.testing.expectEqual(@as(isize, -1), accumulatePixelScroll(&pending_x, -20, 30));
+    try std.testing.expectEqual(@as(f64, -10), pending_x);
+    try std.testing.expectEqual(@as(isize, -1), accumulatePixelScroll(&pending_x, -20, 30));
+    try std.testing.expectEqual(@as(f64, 0), pending_x);
+}
+
+test "Surface: precise scroll reversal discards opposing sub-cell remainder" {
+    var pending: f64 = 0;
+    try std.testing.expectEqual(@as(isize, 0), accumulatePixelScroll(&pending, 29, 30));
+    try std.testing.expectEqual(@as(isize, -1), accumulatePixelScroll(&pending, -30, 30));
+    try std.testing.expectEqual(@as(f64, 0), pending);
+
+    pending = 0;
+    try std.testing.expectEqual(@as(isize, 0), accumulatePixelScroll(&pending, -29, 30));
+    try std.testing.expectEqual(@as(isize, 1), accumulatePixelScroll(&pending, 30, 30));
+    try std.testing.expectEqual(@as(f64, 0), pending);
+
+    pending = 0;
+    try std.testing.expectEqual(@as(isize, 0), accumulatePixelScroll(&pending, 20, 30));
+    try std.testing.expectEqual(@as(isize, 0), accumulatePixelScroll(&pending, 5, 30));
+    try std.testing.expectEqual(@as(isize, 0), accumulatePixelScroll(&pending, 0, 30));
+    try std.testing.expectEqual(@as(f64, 25), pending);
+
+    pending = 0;
+    try std.testing.expectEqual(@as(isize, 0), accumulatePixelScroll(&pending, 20, 30));
+    try std.testing.expectEqual(@as(isize, 0), accumulatePixelScroll(&pending, -5, 30));
+    try std.testing.expectEqual(@as(f64, -5), pending);
+    try std.testing.expectEqual(@as(isize, 0), accumulatePixelScroll(&pending, 0, 30));
+    try std.testing.expectEqual(@as(f64, -5), pending);
+}
