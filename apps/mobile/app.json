{
  "expo": {
    "name": "Prospero",
    "slug": "prospero",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prospero",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.linn0x.prospero",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Prospero 通过本地网络直连你 Mac 上的 prosperod,以控制 code agent 会话。",
        "NSBonjourServices": [
          "_prospero._tcp"
        ],
        "NSCameraUsageDescription": "用于扫描配对二维码,以及拍照作为附件发给 agent。",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSPhotoLibraryUsageDescription": "用于把截图或照片作为附件发给 agent。"
      }
    },
    "android": {
      "package": "com.linn0x.prospero",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "用于扫描 Mac 上的 Prospero 配对二维码。"
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "用于把截图或照片作为附件发给 agent。",
          "cameraPermission": "用于拍照作为附件发给 agent。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}