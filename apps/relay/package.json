{
  "name": "@prospero/relay",
  "version": "0.0.13",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "prospero-relay": "./dist/main.js",
    "prospero-relay-admin": "./dist/admin.js"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js",
    "admin": "node dist/admin.js",
    "bench:load": "node bench/load.mjs",
    "test:bench": "node --test bench/*.test.mjs",
    "bench:failure": "node bench/failure.mjs",
    "test": "npm run build --workspace @prospero/protocol && vitest run",
    "test:integration": "RELAY_INTEGRATION=1 vitest run test/integration.test.ts",
    "test:e2e": "npm run build --workspace @prospero/daemon && npm run build --workspace @prospero/relay && RELAY_REAL_PROCESS_E2E=1 vitest run test/real-process-e2e.test.ts"
  },
  "dependencies": {
    "@prospero/protocol": "0.0.13",
    "mysql2": "3.11.5",
    "pino": "9.5.0",
    "prom-client": "15.1.3",
    "redis": "4.7.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/ws": "8.5.13",
    "tsx": "4.19.2",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
