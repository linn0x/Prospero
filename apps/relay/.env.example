# A public DNS A/AAAA record for this host is required before Caddy can obtain ACME certificates.
RELAY_DOMAIN=relay.example.com
ACME_EMAIL=ops@example.com

# Generate separate long random passwords, for example: openssl rand -base64 32
MYSQL_DATABASE=prospero_relay
MYSQL_USER=prospero
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# Optional: debug, info, warn, error
LOG_LEVEL=info

# Keep the explicit production FD envelope; the Docker/service-manager limit
# must permit these values. Do not publish relay, MySQL, Redis, or metrics.
RELAY_NOFILE_SOFT=131072
RELAY_NOFILE_HARD=131072
CADDY_NOFILE_SOFT=131072
CADDY_NOFILE_HARD=131072

# Conservative public defaults. Capacity runs override these only inside the
# separately named local benchmark project.
AUTH_RATE_PER_MINUTE=20
CONNECTION_RATE_PER_MINUTE=60
MAX_STREAMS_PER_ROUTE=8
CLEANUP_INTERVAL_MS=3600000
