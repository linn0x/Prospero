# A public DNS A/AAAA record for this host is required before Caddy can obtain ACME certificates.
RELAY_DOMAIN=relay.example.com
ACME_EMAIL=ops@example.com

# Generate separate long random passwords, for example: openssl rand -base64 32
MYSQL_DATABASE=prospero_relay
MYSQL_USER=prospero
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# Optional: debug, info, warn, error
LOG_LEVEL=info
