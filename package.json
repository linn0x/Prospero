{
  "name": "prospero",
  "private": true,
  "version": "0.0.1",
  "description": "Control your coding agents from your phone. LAN/WireGuard direct, zero cloud.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper 2>/dev/null || true",
    "typecheck": "tsc --build --force packages/protocol apps/daemon",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.6.0"
  }
}
