{
  "name": "prospero",
  "private": true,
  "version": "0.0.13",
  "license": "MIT",
  "description": "Control your coding agents from your phone. Direct-first with an optional self-hosted E2E relay.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "patch-package && node tools/fix-node-pty-darwin-helper.mjs",
    "typecheck": "tsc --build --force packages/protocol apps/daemon apps/relay",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.6.0"
  }
}
